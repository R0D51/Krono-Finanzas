{
  "name": "krono-finanzas",
  "version": "6.5.42",
  "description": "Krono Finanzas - Aplicacion de Escritorio",
  "author": "Rodrigo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.krono.finanzas",
    "productName": "Krono Finanzas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Krono Finanzas",
      "artifactName": "Krono-Finanzas-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Krono-Finanzas-Portable-${version}.exe"
    }
  }
}